# Free Tier Environment Variables
# Copy this to .env and fill in your credentials

# Application
NODE_ENV=production
PORT=3001
LOG_LEVEL=info

# Neon PostgreSQL (Free Tier)
# Get from: https://neon.tech → Your Project → Connection Details
DATABASE_URL=postgresql://user:password@ep-xxx-xxx.us-east-2.aws.neon.tech/neondb

# Upstash Redis (Free Tier)
# Get from: https://upstash.com → Your Database → Details
REDIS_URL=redis://:password@global-animal-12345.upstash.io:6379

# CloudAMQP RabbitMQ (Free Tier - Little Lemur Plan)
# Get from: https://www.cloudamqp.com → Your Instance → Details
RABBITMQ_URL=amqps://user:pass@coyote.rmq.cloudamqp.com/vhost
RABBITMQ_ENABLED=true
RABBITMQ_EXCHANGE=securestack
RABBITMQ_QUEUE=language-detection

# CORS (adjust for your frontend URL)
CORS_ORIGIN=http://localhost:3000,https://your-frontend.vercel.app

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# Monitoring
ENABLE_METRICS=true
ENABLE_SERVICE_DISCOVERY=false

# Service Info
SERVICE_NAME=@securestack/language-detection-service
SERVICE_VERSION=1.0.0
