{
  "service": {
    "name": "language-detection-service",
    "version": "1.0.0",
    "host": "0.0.0.0",
    "port": 3001
  },
  "services": {},
  "externalApis": {},
  "database": {
    "url": "postgresql://postgres:password@qat-postgres:5432/securestack",
    "pool": {
      "min": 2,
      "max": 10
    }
  },
  "redis": {
    "host": "qat-redis",
    "port": 6379,
    "password": "",
    "db": 0
  },
  "rabbitmq": {
    "url": "amqp://qat-rabbitmq:5672",
    "exchange": "securestack",
    "queues": {
      "languageDetection": "language-detection"
    }
  },
  "cors": {
    "origins": ["https://qat.securestack.com"]
  },
  "logging": {
    "level": "info",
    "format": "json"
  },
  "monitoring": {
    "enabled": true,
    "port": 9090
  }
}
