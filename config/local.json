{
  "service": {
    "name": "language-detection-service",
    "version": "1.0.0",
    "host": "0.0.0.0",
    "port": 3001
  },
  "services": {},
  "externalApis": {},
  "database": {
    "url": "postgresql://postgres:password@localhost:5432/securestack",
    "pool": {
      "min": 2,
      "max": 10
    }
  },
  "redis": {
    "host": "localhost",
    "port": 6379,
    "password": "",
    "db": 0
  },
  "rabbitmq": {
    "url": "amqp://localhost:5672",
    "exchange": "securestack",
    "queues": {
      "languageDetection": "language-detection"
    }
  },
  "cors": {
    "origins": ["http://localhost:3000"]
  },
  "logging": {
    "level": "debug",
    "format": "simple"
  },
  "monitoring": {
    "enabled": true,
    "port": 9090
  }
}
