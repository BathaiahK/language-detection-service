{
  "service": {
    "name": "language-detection-service",
    "version": "1.0.0",
    "host": "0.0.0.0",
    "port": 3001
  },
  "services": {},
  "externalApis": {},
  "database": {
    "url": "postgresql://postgres:password@prd-postgres:5432/securestack",
    "pool": {
      "min": 5,
      "max": 20
    }
  },
  "redis": {
    "host": "prd-redis",
    "port": 6379,
    "password": "",
    "db": 0
  },
  "rabbitmq": {
    "url": "amqp://prd-rabbitmq:5672",
    "exchange": "securestack",
    "queues": {
      "languageDetection": "language-detection"
    }
  },
  "cors": {
    "origins": ["https://securestack.com", "https://app.securestack.com"]
  },
  "logging": {
    "level": "warn",
    "format": "json"
  },
  "monitoring": {
    "enabled": true,
    "port": 9090
  }
}
