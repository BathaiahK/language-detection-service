{
  "name": "@securestack/language-detection-service",
  "version": "1.0.0",
  "description": "Microservice for detecting programming languages in codebases",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "jest --config=jest.config.e2e.js",
    "test:e2e:watch": "jest --config=jest.config.e2e.js --watch",
    "test:e2e:coverage": "jest --config=jest.config.e2e.js --coverage",
    "test:e2e:local": "npm run build && docker-compose -f docker-compose.test.yml up -d && sleep 30 && npm run test:e2e; docker-compose -f docker-compose.test.yml down -v",
    "test:all": "npm run test && npm run test:e2e",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "docker:build": "docker build -t securestack/language-detection:latest .",
    "docker:run": "docker run -p 3001:3001 securestack/language-detection:latest",
    "docker:test:up": "npm run build && docker-compose -f docker-compose.test.yml up -d",
    "docker:test:down": "docker-compose -f docker-compose.test.yml down -v"
  },
  "keywords": [
    "language-detection",
    "code-analysis",
    "microservice",
    "security"
  ],
  "author": "SecureStack",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "joi": "^17.11.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.1.5",
    "prom-client": "^15.1.0",
    "amqplib": "^0.10.3",
    "node-cache": "^5.1.2",
    "envalid": "^8.0.0",
    "ignore": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/node": "^20.10.6",
    "@types/jest": "^29.5.11",
    "@types/amqplib": "^0.10.4",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "supertest": "^6.3.3",
    "@types/supertest": "^6.0.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
